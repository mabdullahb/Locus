# Copy this file to .env and fill in the values below.
#
# This app is meant to be self-hosted: you bring your own database, your own
# Redis, and your own search/AI provider keys (added per-account in Settings
# once the app is running, not as env vars here). There is no hosted version
# of this app run by its maintainers, whoever runs it is responsible for the
# server it runs on.
#
# Two ways to run this:
#   - `docker compose up --build` reads this same file and runs everything
#     (Postgres, Redis, the app, and the worker) together. See README.md.
#   - `npm run dev:all` for local development without Docker, against
#     whatever Postgres/Redis you already have running.

# Database
DATABASE_URL="postgresql://locus:locus_dev@localhost:5433/locus"
# Only read by docker-compose.yml, to set the Postgres container's own
# credentials (which DATABASE_URL above must then match). Change the
# password for anything beyond local testing.
POSTGRES_USER="locus"
POSTGRES_PASSWORD="locus_dev"
POSTGRES_DB="locus"

# Queue
REDIS_URL="redis://localhost:6379"

# Express Server (the background worker: runs searches and enrichment)
SERVER_PORT=4000
# Interface the worker binds to. Defaults to 0.0.0.0 (all interfaces) if
# unset, matching Node's own default. Set to 127.0.0.1 only when the Next.js
# app and this worker always run on the very same host and network
# namespace (not the case under docker-compose, where they're separate
# containers), since /api/scrape/* trusts a client-supplied userId gated
# only by INTERNAL_API_SECRET below, not a verified session.
# SERVER_HOST=127.0.0.1
# Origin allowed to call the worker's CORS endpoints and connect to its
# WebSocket. Under docker-compose this is the app container's internal
# address (see docker-compose.yml); set it to your real deployed frontend
# URL for a non-Docker production deployment.
FRONTEND_ORIGIN="http://localhost:3000"
# Shared secret the Next.js app sends with internal calls to the worker's
# /api/scrape/* endpoints. Without a match the worker rejects the call.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=""

# Business search and AI enrichment provider keys (SerpApi, Serper.dev, Google
# Places, Gemini, Claude, OpenAI, OpenRouter) are not env vars at all — each
# user adds their own key in Settings > API Keys once logged in, encrypted
# at rest with ENRICHMENT_KEY_SECRET below.

# Optional self-hosted OpenAI-compatible router (the admin-only "9Router"
# provider), a URL exposing /v1/models and /v1/chat/completions. Leave blank
# to disable that provider. https works anywhere. Plain http works for a
# localhost or LAN router as-is; for an http router on a public address set
# NINE_ROUTER_ALLOW_INSECURE_HTTP=true (the request carries the API key, so
# only do this on a network you trust).
NINE_ROUTER_BASE_URL=""
NINE_ROUTER_ALLOW_INSECURE_HTTP=""
# Encryption key for at-rest API key storage — generate with: openssl rand -hex 32
ENRICHMENT_KEY_SECRET=""
# Rate limiting: max enrichments per ENRICHMENT_RATE_WINDOW seconds per user.
# This protects against a runaway session hammering the user's OWN provider
# key too fast — BYOK means Locus doesn't front the API cost, so this isn't
# a cost-protection cap. Set high enough that one normal extraction (~100
# leads, run in parallel batches) doesn't trip it.
ENRICHMENT_RATE_LIMIT=100
ENRICHMENT_RATE_WINDOW=60

# NextAuth.js
# The app's own real public URL. http://localhost:3000 for local testing;
# your real domain (https://yourdomain.com) for an actual deployment.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""  # Generate with: openssl rand -base64 32

# Transactional email (password reset). Leave RESEND_API_KEY blank and the
# reset link is logged to the server console instead of emailed, fine for
# local testing, not for real users who need the email in their inbox.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="Locus <onboarding@resend.dev>"

# Sentry (error monitoring, optional)
NEXT_PUBLIC_SENTRY_DSN=""  # Get from https://sentry.io/settings/<org>/projects/<project>/keys/
SENTRY_ORG=""
SENTRY_PROJECT="locus"

# Frontend (NEXT_PUBLIC_* are inlined into the browser bundle at build time,
# not read at container startup — changing these after building a Docker
# image has no effect until it's rebuilt. See the comments in
# docker-compose.yml for what each needs to be set to under Docker.)
NEXT_PUBLIC_WS_URL="ws://localhost:4000/ws"
NEXT_PUBLIC_SERVER_URL="http://localhost:4000"

# Set to "true" only if this app sits behind a reverse proxy, load balancer,
# or platform edge that overwrites the client-supplied X-Forwarded-For header
# with the real client IP. If this app's port is ever exposed directly to
# the internet with nothing in front of it, leave this unset/false,
# otherwise anyone can bypass login/register/password-reset rate limiting by
# sending a fake X-Forwarded-For value on every request.
TRUST_PROXY_HEADERS="false"
